__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/

# Run artifacts. Everything under outputs/ belongs to the run that made it, on
# the machine that made it.
#
# These were committed once, and the consequence was worse than clutter: a fresh
# clone arrived with ten strategy-library entries about somebody else's paper.
# The library exists to answer "has this question been asked before", and
# trials_for_family feeds the deflated Sharpe trial count -- so a shipped
# library makes a new fund inherit another research programme's trial budget
# and prior answers. The worked examples are kept, for reference, in
# examples/outputs/.
outputs/**
!outputs/.gitkeep
!outputs/README.md

# Third-party and licensed content never goes into git (purged from history 2026-11-06).
data/processed/**
data/raw/**
docs/papers/**
docs/devanathan_2026_simple_dynamic_sbg.pdf
docs/*__transcript.txt
examples/outputs/**/*.parquet
# Machine-local paths to the data files (see config/local.example.yaml).
config/local.yaml

# Derived data built from the three sources (ros/data/sources.py): the Parquet copy of the Ace price file
# (~1 GB), the security master and the membership snapshots. Rebuilt automatically when the source changes.
data/processed/ace/
data/processed/nifty500/

# The SE reference workbook holds real fund returns: never in git (Wave 5, 2026-11-12). The reference check runs only where it exists.
/reference/
